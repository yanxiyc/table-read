# Cartesia (TTS for runtime engine)
CARTESIA_API_KEY=replace_with_your_cartesia_api_key
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_TTS_MODEL=sonic-3
ENABLE_CARTESIA=true
DEFAULT_PACE=1.0
CARTESIA_TTS_USE_SSML_EMOTION=true

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_your_livekit_api_secret

# Anthropic (for AI Director)
ANTHROPIC_API_KEY=replace_with_your_anthropic_key

# CORS (comma-separated origins, default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

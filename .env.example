# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_your_livekit_api_secret

# Anthropic (for AI Director)
ANTHROPIC_API_KEY=replace_with_your_anthropic_key

# Notion (scene persistence)
NOTION_TOKEN=replace_with_your_notion_integration_token
NOTION_DATABASE_ID=replace_with_your_notion_scenes_database_id

# Data directory (fallback file-based storage)
SCENE_DATA_DIR=data/scenes
DEFAULT_PACE=1.0

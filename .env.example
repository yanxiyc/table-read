# Cartesia credentials
CARTESIA_API_KEY=replace_with_your_api_key
CARTESIA_AGENT_ID=

# Cartesia API + models
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_STT_MODEL=ink-whisper

# Runtime behavior
ENABLE_CARTESIA=true
DEFAULT_PACE=1.0

# Expression controls
CARTESIA_TTS_USE_SSML_EMOTION=true

# Optional LiveKit setup
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
